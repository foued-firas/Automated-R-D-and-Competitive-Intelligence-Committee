    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst context = items\n  .slice(0, 10)\n  .map((item, i) => {\n    const doc = item.json.document || {};\n    const text = doc.pageContent || '';\n    const score = item.json.score ?? null;\n\n    return `--- Résultat ${i + 1} (score: ${score}) ---\n${text}`;\n  })\n  .join('\\n\\n');\n\nreturn [\n  {\n    json: {\n      context\n    }\n  }\n];"
      },
