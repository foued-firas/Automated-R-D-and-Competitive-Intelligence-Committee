    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst chunkSize = 1000;\nconst overlap = 200;\n\nconst output = [];\n\nfor (const item of items) {\n  const text = item.json.text || '';\n\n  if (!text) continue;\n\n  // Identité du document d'origine\n  const fileName =\n    item.json.info?.Title ||\n    item.json.fileName ||\n    item.json.filename ||\n    'unknown_document';\n\n  // Déduction de l'année depuis le nom/titre du document\n  const yearMatch = fileName.match(/\\b(2024|2025|2026)\\b/);\n  const year = yearMatch ? Number(yearMatch[1]) : null;\n\n  const documentId = year\n    ? `estee_lauder_${year}`\n    : fileName.replace(/[^a-zA-Z0-9]+/g, '_').toLowerCase();\n\n  let start = 0;\n  let chunkIndex = 0;\n\n  while (start < text.length) {\n    const end = Math.min(start + chunkSize, text.length);\n    const chunk = text.slice(start, end).trim();\n\n    if (chunk) {\n      output.push({\n        json: {\n          text: chunk,\n\n          // Identité du document\n          document_id: documentId,\n          document_title: fileName,\n          year: year,\n\n          // Identité du chunk\n          chunk_id: `${documentId}_chunk_${chunkIndex}`,\n          chunk_index: chunkIndex,\n\n          // Position dans le document\n          chunk_start: start,\n          chunk_end: end,\n        }\n      });\n    }\n\n    if (end >= text.length) break;\n\n    start = end - overlap;\n    chunkIndex++;\n  }\n}\n\nreturn output;"
      },
